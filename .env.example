# Service ports
REALITY_ENGINE_PORT=5601
PERCEPTION_ENGINE_PORT=5600
VECTOR_DIMENSION=7680

# Machine repositories
MACHINES_DIR=../RealityEngine_Machines/machines
LOCAL_AI_MACHINES_DIR=../localAIStack/data/machines

# Shared Qdrant/localAI context retained for configuration equivalence.
QDRANT_URL=http://localhost:4333
QDRANT_GRPC_URL=http://localhost:4334
QDRANT_STORAGE_DIR=../localAIStack/volumes/qdrant
QDRANT_LOCALAI_COLLECTION=localai_docs
QDRANT_REALITY_COLLECTION=reality-vectors
LOCAL_AI_API_URL=http://localhost:4000
LOCAL_AI_BOOTSTRAP=false

# PE integration registry — HealthKit / CareKit ingest routing.
# When set, the PE loads this file at startup and routes /api/integrations/healthkit/ingest
# and /api/integrations/carekit/ingest payloads to the declared perceptual-space regions.
# localAIStack personal-health domain:
INTEGRATIONS_CONFIG=../localAIStack/config/pe-integrations.json

# Runtime options
RE_INCLUDE_MACHINE_RESULTS=true
RE_INCLUDE_PERCEPTUAL_SPACE=true
RE_HISTORY_LIMIT=250

