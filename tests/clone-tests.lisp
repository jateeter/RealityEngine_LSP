(in-package #:reality-engine-lsp.tests)

;;; Cloneable machines (SURFACE_SPEC.md, "Cloneable machines"): each rule of the
;;; nine-rule table by the reason code a machine failing only that rule gets;
;;; the listing; the block space (lowest free first, a generation per block);
;;; and that a clone shares no Reality Event with its template.

(defun clone-fixture (file metadata &key (in 4) (out 4) (mapping t))
  (let* ((stem (subseq file 0 (- (length file) 5)))
         (json (reality-engine-lsp::parse-json
                (format nil "{\"version\": \"1.0.0\", \"machine\": {\"name\": \"~a\", ~a \"metadata\": ~a, \"sequences\": [{\"id\": \"s\", \"name\": \"S\", \"events\": [{\"id\": \"v1\", \"isInitial\": true, \"elements\": [{\"value\": 1}], \"nextEventIds\": [\"v2\"]}, {\"id\": \"v2\", \"isInitial\": false, \"elements\": [{\"value\": 1}]}]}]}}"
                        stem
                        (if mapping
                            (format nil "\"perceptualMapping\": {\"input\": {\"offset\": 0, \"length\": ~d}, \"output\": {\"offset\": 100, \"length\": ~d}}," in out)
                            "")
                        metadata)))
         (machine (machine-from-json json (format nil "machine-~a" (string-downcase stem)))))
    (setf (reality-engine-lsp::machine-source-file machine) file)
    machine))

(defun test-clone-space ()
  (let* ((producer "{\"type\": \"published-domain-bus-producer\", \"targetMachineFile\": \"Bus.json\", \"targetInputElements\": [0, 1, 2]}")
         (agent "\"agentBinding\": {\"agent\": \"a\"}")
         (machines (make-hash-table :test #'equal)))
    (flet ((md (extra edges)
             (format nil "{~a~a, \"interconnections\": [~a]}" agent (if (plusp (length extra)) (format nil ", ~a" extra) "") edges))
           (put (m) (setf (gethash (reality-engine-lsp::machine-id m) machines) m)))
      (put (clone-fixture "Ok.json" (md "" producer)))
      (put (clone-fixture "NoAgent.json" (format nil "{\"interconnections\": [~a]}" producer)))
      (put (clone-fixture "Handoff.json" "{\"interconnections\": [{\"type\": \"document-workflow-handoff\", \"sourceMachine\": \"Handoff\"}]}"))
      (put (clone-fixture "HandoffElsewhere.json" "{\"interconnections\": [{\"type\": \"document-workflow-handoff\", \"sourceMachine\": \"Other\"}]}"))
      (put (clone-fixture "NoFanout.json" (md "" "")))
      (put (clone-fixture "Bus.json" (md "" producer)))
      (put (clone-fixture "Safety.json" (md "\"severity\": \"life-safety\"" producer)))
      (put (clone-fixture "Fixture.json" (md "\"tags\": [\"x\", \"test-fixture\"]" producer)))
      (put (clone-fixture "Out.json" (md "\"cloneable\": false" producer)))
      (put (clone-fixture "WideIn.json" (md "" producer) :in 17))
      (put (clone-fixture "WideOut.json" (md "" producer) :in 16 :out 17))
      (put (clone-fixture "NoMapping.json" (md "" producer) :mapping nil))
      (put (clone-fixture "WideFan.json" (md "" (format nil "~{~a~^, ~}" (make-list 6 :initial-element producer)))))
      (let ((targets (reality-engine-lsp::bus-target-files machines)))
        (assert-equal '("Bus.json") (loop for k being the hash-keys of targets collect k) "bus targets")
        (flet ((verdict (id) (multiple-value-list (reality-engine-lsp::assess-cloneable (gethash id machines) targets))))
          (assert-equal '(t nil 7 3) (verdict "machine-ok") "Ok is cloneable, n = 3 + 4")
          (assert-equal '(t nil 4 0) (verdict "machine-handoff") "a handoff folds no cells")
          (dolist (case '(("machine-noagent" "no-agentic-action") ("machine-handoffelsewhere" "no-agentic-action")
                          ("machine-nofanout" "no-fanout") ("machine-bus" "bus-target")
                          ("machine-safety" "life-safety") ("machine-fixture" "fixture")
                          ("machine-out" "opted-out") ("machine-widein" "input-too-long")
                          ("machine-wideout" "output-too-long") ("machine-nomapping" "input-too-long")))
            (assert-equal (second case) (second (verdict (first case))) (format nil "reason for ~a" (first case))))
          (assert-equal '(nil "fanout-too-wide" 22 18) (verdict "machine-widefan") "rule 9 reports n")
          (assert-equal nil (third (verdict "machine-bus")) "n only once rule 9 is evaluated")))
      ;; A machine with no file can be neither a handoff source nor a bus target.
      (let ((bare (clone-fixture "Handoff.json" "{\"interconnections\": [{\"type\": \"document-workflow-handoff\", \"sourceMachine\": \"Handoff\"}]}")))
        (setf (reality-engine-lsp::machine-source-file bare) nil)
        (assert-equal "no-agentic-action"
                      (nth-value 1 (reality-engine-lsp::assess-cloneable bare (make-hash-table :test #'equal)))
                      "a body-registered machine has no file stem"))
      ;; The listing: sorted by id, clones left out.
      (let ((space (reality-engine-lsp::make-clone-space-state))
            (template (gethash "machine-ok" machines)))
        (flet ((mk (id blk gen)
                 (reality-engine-lsp::make-clone :clone-id id :machine-id "machine-ok" :engine-instance "lsp-1"
                                                 :envelope-id (format nil "e-~a" id) :asset-id "a" :block blk :generation gen
                                                 :input-length 4 :output-length 4 :fanout-length 3)))
          (let* ((c (mk "machine-ok.lsp-1.e-c" 0 0))
                 (clone (reality-engine-lsp::make-clone-machine template c)))
            (setf (gethash (reality-engine-lsp::machine-id clone) machines) clone)
            (let* ((listed (coerce (reality-engine-lsp::jget (reality-engine-lsp::cloneable-listing-json machines) "machines") 'list))
                   (ids (mapcar (lambda (e) (reality-engine-lsp::jget e "id")) listed)))
              (assert-equal (sort (copy-list ids) #'string<) ids "listing sorted by id")
              (assert-true (not (member "machine-ok.lsp-1.e-c" ids :test #'equal)) "clones are not listed")
              (assert-equal (1- (hash-table-count machines)) (length ids) "every other machine listed"))
            ;; The clone steps its own events: advancing it leaves the template at its initial state.
            (reality-engine-lsp::process-machine-input clone (list 1))
            (let ((active (lambda (m)
                            (loop for s in (reality-engine-lsp::machine-sequence-list m)
                                  append (loop for v being the hash-values of (reality-engine-lsp::sequence-vectors s)
                                               when (reality-engine-lsp::reality-event-active-p v)
                                                 collect (reality-engine-lsp::reality-event-id v))))))
              (assert-equal '("v1") (funcall active template) "the template is untouched by its clone's step")
              (assert-true (member "v2" (funcall active clone) :test #'equal) "the clone advanced"))
            (assert-equal 20480 (reality-engine-lsp::region-offset (reality-engine-lsp::mapping-input (reality-engine-lsp::machine-mapping clone))) "clone input in block 0")
            (assert-equal 20496 (reality-engine-lsp::region-offset (reality-engine-lsp::mapping-output (reality-engine-lsp::machine-mapping clone))) "clone output quarter")
            (assert-equal 100 (reality-engine-lsp::region-offset (reality-engine-lsp::mapping-output (reality-engine-lsp::machine-mapping template))) "template regions unchanged")))
        ;; The block space.
        (flet ((mk (id blk gen)
                 (reality-engine-lsp::make-clone :clone-id id :machine-id "machine-ok" :envelope-id (format nil "e-~a" id)
                                                 :block blk :generation gen :input-length 4 :output-length 3 :fanout-length 3)))
          (assert-equal 0 (reality-engine-lsp::clone-space-lowest-free space) "block 0 first")
          (reality-engine-lsp::clone-space-add space (mk "a" 0 0))
          (reality-engine-lsp::clone-space-add space (mk "b" 1 0))
          (assert-equal 2 (reality-engine-lsp::clone-space-lowest-free space) "lowest free")
          (assert-equal 2 (reality-engine-lsp::clone-space-live-of space "machine-ok") "live count")
          (assert-equal 1 (reality-engine-lsp::clone-space-recycle space "a") "recycle increments the generation")
          (assert-equal 0 (reality-engine-lsp::clone-space-lowest-free space) "a recycled block is reused first")
          (assert-error (lambda () (reality-engine-lsp::clone-space-recycle space "a")) "a replayed recycle")
          (let ((j (reality-engine-lsp::clone-json (mk "c" 1 0))))
            (assert-equal 20544 (reality-engine-lsp::jget (reality-engine-lsp::jget j "block") "offset") "block 1 offset")
            (assert-equal 20576 (reality-engine-lsp::jget (reality-engine-lsp::jget j "fanout") "offset") "fanout quarter")
            (assert-equal 20592 (reality-engine-lsp::jget (reality-engine-lsp::jget j "bus") "offset") "bus quarter")
            (assert-equal 4 (reality-engine-lsp::jget (reality-engine-lsp::jget j "bus") "length") "bus cells")))))
    (format t "~&clone space: ok~%")))
